# Токен бота от @BotFather
BOT_TOKEN=123456789:AAабвгдеЁЖЗИЙ_пример_токена

# Neon Postgres: используйте pooled-connection строку (хост с суффиксом -pooler)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Telegram id пользователей, которые получат роль admin/trainer автоматически при первом входе
ADMIN_TG_IDS=111111111
TRAINER_TG_IDS=222222222,333333333

# Домен фронтенда для CORS в проде (в самом Vercel-деплое можно оставить "*", т.к. фронт и API на одном домене)
ALLOWED_ORIGIN=*

# URL вашего деплоя — используется в кнопке "Открыть приложение" под /start
APP_URL=https://hse-sport-centre.vercel.app

# Произвольная случайная строка — проверяет, что вебхук зовёт именно Telegram, а не кто угодно.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=
